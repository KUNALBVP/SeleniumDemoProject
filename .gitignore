# Ignore build and dependency files
/target/
*.class
*.jar
*.war
*.ear

# Ignore IDE-specific files
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ignore maven-specific files
.mvn/
mvnw
mvnw.cmd

# Ignore log and output files
*.log
/logs/
*.out
*.err

# Ignore test reports and screenshots
/test-output/
screenshots/
allure-results/
reports/
ExtentReport/
*.html

# Ignore generated selenium web driver files
chromedriver.log
geckodriver.log
selenium-server.log

# Ignore compiled and temporary files
/bin/
*.swp
*.DS_Store
Thumbs.db

# Ignore node modules (if using any JS tools)
node_modules/

# Ignore dependency caching
/.m2/